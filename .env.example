# ---------------------------------------------------------------------------
# Smart Energy Guardian — environment configuration (copy to .env)
# ---------------------------------------------------------------------------
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO

# --- Security (MUST change for anything beyond a local demo) ---------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guardian-demo
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Hardware safety -------------------------------------------------------
# Physical relay switching stays OFF until the installation has been independently
# validated. Even when true, each ESP32 must also be marked "control validated" by an admin.
REAL_SWITCHING_ENABLED=false

# --- Storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/energy_guardian.db
# MODEL_DIR=./data/models

# --- Timing ----------------------------------------------------------------
COMMAND_TIMEOUT_SECONDS=20
DEVICE_OFFLINE_SECONDS=30
TELEMETRY_STALE_SECONDS=45
MONITOR_INTERVAL_SECONDS=3
MAX_INTEGRATION_GAP_SECONDS=300

# --- Simulation (hardware-free demo) --------------------------------------
SIMULATION_ENABLED=true
SIMULATION_AUTOSTART=true
SIMULATION_TICK_SECONDS=3
SEED_DEMO_DATA=true
HISTORY_BACKFILL_DAYS=7
SIMULATION_SEED=42

# --- Background work ------------------------------------------------------
BACKGROUND_TASKS_ENABLED=true
ML_AUTOTRAIN=true
